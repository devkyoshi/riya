{
  "name": "@riya/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "cross-env DATABASE_URL=postgresql://riya:riya_dev_password@localhost:5433/riya_test tsx src/db/migrate.ts",
    "db:seed": "tsx src/seeds/index.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "@sinclair/typebox": "^0.32.35",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.14",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "googleapis": "^140.0.1",
    "ioredis": "^5.3.2",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "fastify-plugin": "^4.5.1",
    "pino-pretty": "^11.0.0",
    "google-auth-library": "^9.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.21.4",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
