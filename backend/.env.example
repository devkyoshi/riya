# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://riya:riya_dev_password@localhost:5432/riya_dev
DATABASE_URL_TEST=postgresql://riya:riya_dev_password@localhost:5433/riya_test

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:riya_redis_password@localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_SIZE_BYTES=10485760

# ─── Seed (only used by db:seed script) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@riya.dev
SEED_ADMIN_PASSWORD=Admin@riya2024!
