# Root-level environment variables (shared context)
# Copy to .env and fill in values before running

# ─── Postgres (matches docker-compose.yml) ───────────────────────────────────
POSTGRES_USER=riya
POSTGRES_PASSWORD=riya_dev_password
POSTGRES_DB=riya_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=riya_redis_password
